---
import NavBar from '../components/NavBar.astro';
import Layout from '../layouts/Layout.astro';
import HorizontalBanner from '../components/HorizontalBanner.astro'

import HorizontalStrip from '../layouts/HorizontalStrip.astro'
import SingleSection from "../components/SingleSection.astro";
import SingleImageSection from '../components/SingleImageSection.astro';
import SingleGoogleReview from '../components/SingleGoogleReview.astro';

//Hero Block
const { companyName = "Ziva Komerc" } = Astro.props;
const { companyAddress = ["8 Pere Segedinca", "Pancevo", "Serbia"]} = Astro.props;
const { phoneNumber = "000 000 000"} = Astro.props;
const { heroImgSrc = "src/images/HeroImage.png"} = Astro.props;


---

<Layout>	
	

	<HorizontalStrip>
		<SingleImageSection slot="left" alt="Head image of Ziva Komerc Store" imgSrc={heroImgSrc} />
		<SingleSection slot="right" headText={companyName} bodyText={companyAddress[1]} footText={phoneNumber} />
	  </HorizontalStrip>

	  <HorizontalStrip>
		<SingleSection slot="left" headText={companyName} bodyText={companyAddress[1]} footText={phoneNumber} />
		<SingleImageSection slot="right" />
	  </HorizontalStrip>
	  	
	  <HorizontalStrip>
		<SingleGoogleReview slot="left" headText="Bob" bodyText="Bob bob bob" numberOfStars={3}/>
		<SingleGoogleReview slot="left" headText="Bob" bodyText="Bob bob bob" numberOfStars={6}/>
		<SingleGoogleReview slot="right" headText="Bob" bodyText="Bob bob bob" numberOfStars={4}/>
		<SingleGoogleReview slot="right" headText="Bob" bodyText="Bob bob bob" numberOfStars={5}/>
	  </HorizontalStrip>

</Layout>
