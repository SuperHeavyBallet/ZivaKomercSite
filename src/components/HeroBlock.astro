---
const { headText, bodyText, anchorText } = Astro.props;
const { anchorHref } = Astro.props;

//
---

<div class="p-5 m-5 max-w-120 flex flex-col justify-center">
    <h1 class="align-middle justify-center text-center mb-1.5 font-bold text-4xl">{headText}</h1>
    <h3 class=" justify-center text-center mb-1.5 font-bold text-2xl">{bodyText}</h3>
    <a href={anchorHref}>{anchorText}</a>
</div>